# ---- Datasets ----
# Ignore everything under data/ EXCEPT the HAR dataset, which has no
# auto-download path and must ship with the repo so the project runs after clone.
data/*
!data/har/
# Skip the large precomputed 561-feature files (X_*.txt); the TCN model reads
# the raw Inertial Signals instead, so these ~47MB files are unused.
data/har/**/X_*.txt
experiments/run_femnist_mia_beta_sweep.py